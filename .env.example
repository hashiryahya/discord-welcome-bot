# ==========================================
# DISCORD BOT ENVIRONMENT CONFIGURATION
# ==========================================

# Your Discord Bot Token (Found at https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application (Client) ID
CLIENT_ID=your_client_id_here

# Optional: Server (Guild) ID for instantaneous slash command registration during development
# Leave empty to register commands globally across all servers
GUILD_ID=your_development_guild_id_here
